# freegate configuration — copy to .env and edit

# Server port
PORT=1234

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Admin token — required, >=6 chars (user-defined password). Protects dashboard (/, /partials/*, /api/*) and is also valid for /v1/* (superset).
# Generate with: openssl rand -hex 32  (or any password >=6 chars)
ADMIN_TOKEN= # required, >=6 chars

# /v1/* also accepts DB-managed client keys: create them at /settings (or
# POST /api/api-keys) after first login. Without one, /v1/* stays
# admin-gated — only the fg_admin login cookie or a raw ADMIN_TOKEN header
# grants access, there is no open API.
# The old API_KEY env var was removed: a stale value is ignored (the server
# logs a warning on boot) and its keys no longer authenticate.

# Rate limit per IP (requests per minute)
RATE_LIMIT=60

# Maximum /v1/* request body size in MB (default 30). Oversized bodies get 413.
MAX_REQUEST_BODY_MB=30

# Trust X-Forwarded-For / X-Real-IP when deriving the client IP (rate limit
# buckets, logs, request history). Leave false when freegate is exposed
# directly — forwarded headers are client-controlled and spoofable. Set true
# ONLY behind a reverse proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false

# === Upstream: OpenCode (default) ===
UPSTREAM_URL_OPENCODE=https://opencode.ai/inference/v1
# The free-tier gate allowlists Bun's TLS ClientHello and rejects stock Go
# crypto/tls with 429 FreeUsageLimitError even when the HTTP request is
# byte-identical. Keep true; only the configured OpenCode host uses the Bun
# handshake, while relay hosts keep standard Go TLS. Set false as a kill
# switch if upstream stops requiring the Bun fingerprint.
UPSTREAM_OPENCODE_BUN_TLS=true
# Comma-separated API keys. freegate rotates them round-robin per request so
# per-key rate limits spread across accounts. Default "public" (anonymous).
UPSTREAM_KEY_OPENCODE=public

# Comma-separated model IDs that are free on the OpenCode upstream but do
# not follow the "-free" naming convention. These get served even without
# the suffix. Default includes "big-pickle" (served as deepseek-v4-flash
# with cost 0 by the upstream) and "union-alpha" (Messages API model).
UPSTREAM_OPENCODE_FREE_ALLOWLIST=big-pickle,union-alpha
UPSTREAM_REFRESH_OPENCODE=60

# === Egress: in-process WARP (optional) ===
# Routes OpenCode traffic through WARP exits that run inside freegate. Each
# exit is its own Cloudflare device. When the upstream answers 429
# FreeUsageLimitError (quota is counted per exit IPv6 /64), freegate retires
# the exit that served the request and retries from a replacement. Generic
# 429s (per-key rate limits) do not trigger rotation.
#
# Enable with the single compose file by setting EGRESS_MODE=warp here:
#   docker compose up -d
#
# off = direct connections (default). warp = dial OpenCode through WARP.
EGRESS_MODE=off
# Tunnel address family: dual (IPv6 first, IPv4 fallback) or ipv6 (IPv6 only).
# Use dual when an upstream publishes only A records, such as api.kilo.ai.
WARP_STACK=dual
# Upper bound on simultaneously registered exits.
WARP_POOL_SIZE=2
# Routed IPv6 prefix each exit binds its outer source to. "auto" (default)
# detects a public prefix from the host; an explicit /64 overrides it.
# Every replacement needs a different source to get a fresh quota /64.
# If auto finds no public prefix, WARP still runs over IPv4 but rotation is
# less effective (a warning is logged).
WARP_SOURCE_IPV6=auto
# Startup bound for the first Cloudflare registration (rate limits are
# waited out inside this window); and how long a retry waits for a fresh exit.
WARP_REGISTRATION_TIMEOUT=5m
WARP_ROTATE_WAIT=30s
# Fall back to the host's own IP when no exit is available. Keep false to
# fail closed instead of leaking the host address.
EGRESS_FALLBACK_DIRECT=false

# === Upstream: Kilo ===
UPSTREAM_URL_KILO=https://api.kilo.ai/api/openrouter
UPSTREAM_KEY_KILO=anonymous
UPSTREAM_REFRESH_KILO=60

# === Upstream: LLM7 (keyless gateway) ===
# api.llm7.io is a keyless free gateway: any non-empty bearer token works.
# freegate sends "unused" by convention; the upstream ignores its value.
UPSTREAM_URL_LLM7=https://api.llm7.io/v1
# How often to refresh the LLM7 /models catalog (seconds). 300s balances
# freshness vs free-relay pressure; last-known models stay cached on failure.
UPSTREAM_REFRESH_LLM7=300

# === Routing ===
# Default upstream: "opencode", "kilo", or "llm7". Used as fallback when a
# model is not claimed by any other upstream or combo tier.
UPSTREAM_DEFAULT=opencode

# === Responses API direct config ===
# Comma-separated substrings (case-insensitive) matched against model ID to
# decide which models use the OpenAI Responses API (/v1/responses) instead of
# Chat Completions (/v1/chat/completions). Default covers Muse Spark family.
# Example: RESPONSE_MODELS=muse-spark,custom-model
RESPONSE_MODELS=muse-spark,muse_spark,muse-ember,muse-wonder

# === Messages API direct config (OpenCode inference) ===
# Comma-separated substrings (case-insensitive) matched against model ID to
# decide which models use the Anthropic Messages API (/inference/v1/messages)
# with compliant v2 headers per 9router PR #4842. Default covers Union Alpha
# and free Anthropic Messages models.
# Example: MESSAGE_MODELS=union-alpha,minimax-m3-free
MESSAGE_MODELS=union-alpha,minimax-m2.5-free,minimax-m3-free,minimax-m2.1-free,qwen3.6-plus-free

# === Raw upstream response log (debugging) ===
# Master switch, default false. When true, every upstream response line is
# printed to stdout via slog ("upstream raw response", with request-id and
# model) so degenerate upstream behavior — e.g. muse-spark streams that end
# without [DONE] — is visible directly in the server log.
# WARNING: lines contain full conversation content; enable only while
# debugging on trusted machines.
UPSTREAM_CAPTURE=false

# Custom providers + combos SQLite (GORM, pure-Go, CGO-free). Auto-created on
# boot at this path. Holds custom OpenAI-compatible providers, tiered routing
# combos (virtual models), and — once seeded — auth + upstream settings.
# Persist it: mount a volume over ./data in docker (see docker-compose.yml),
# back up the file before upgrades.
PROVIDERS_DB_PATH=./data/providers.db
