[TEMPLATE]
# freegate configuration

# Server port
PORT=1234

# VPN settings (single-binary per-OS mode)
# freegate embeds VPNGate OpenVPN per OS (linux/darwin/windows) and exposes
# SOCKS5 on 127.0.0.1:9050 in-process. No Docker sidecar required.
# Set VPN_ENABLED=false or run with --vpn=false for direct (no tunnel).
VPN_ENABLED=true
VPN_PROVIDER=auto
VPNGATE_SOCKS_PORT=9050
VPNGATE_CTRL_PORT=8080
# Minimum seconds between scheduled IP rotations (ForceNewIP bypasses it)
VPNGATE_ROTATE_INTERVAL=30
# VPN server selection filters (applied in-process). Empty = every relay.
# VPNGATE_COUNTRY=Japan
# VPNGATE_MIN_SCORE=500000
# VPNGATE_MAX_PING=100
# Legacy docker sidecar compat (optional): if VPNGATE_HOST is set to "vpn",
# SOCKS will dial that host instead of 127.0.0.1.
# VPNGATE_HOST=vpn

# Log level: debug, info, warn, error
LOG_LEVEL=info

# API key for client authentication (leave empty to disable auth)
API_KEY=

# Rate limit per IP (requests per minute)
RATE_LIMIT=60

# === Upstream: OpenCode (default) ===
UPSTREAM_URL_OPENCODE=https://opencode.ai/zen/v1
# Comma-separated API keys. freegate rotates them round-robin per request so
# per-key rate limits spread across accounts. Default "public" (anonymous).
UPSTREAM_KEY_OPENCODE=public

# Comma-separated model IDs that are free on the OpenCode upstream but do
# not follow the "-free" naming convention. These get served even without
# the suffix. Default includes "big-pickle" (served as deepseek-v4-flash
# with cost 0 by the upstream).
UPSTREAM_OPENCODE_FREE_ALLOWLIST=big-pickle

# === Upstream: Kilo ===
UPSTREAM_URL_KILO=https://api.kilo.ai/api/openrouter
UPSTREAM_KEY_KILO=anonymous

# === Upstream: LLM7 (keyless gateway) ===
# api.llm7.io is a keyless free gateway: any non-empty bearer token works.
# freegate sends "unused" by convention; the upstream ignores its value.
UPSTREAM_URL_LLM7=https://api.llm7.io/v1
# How often to refresh the LLM7 /models catalog (seconds). 300s balances
# freshness vs free-relay pressure; last-known models stay cached on failure.
UPSTREAM_REFRESH_LLM7=300

# === Routing ===
# Default upstream: "opencode" or "kilo"
UPSTREAM_DEFAULT=opencode
