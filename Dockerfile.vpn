FROM golang:1.26-alpine3.22 AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o vpngate-supervisor ./cmd/vpngate-supervisor

FROM alpine:3.20
RUN apk add --no-cache openvpn iproute2 ca-certificates
COPY --from=builder /build/vpngate-supervisor /usr/local/bin/vpngate-supervisor
EXPOSE 9050 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/vpngate-supervisor"]
