# Keep the build context limited to what the Go build needs. web/ must
# stay: it is compiled into the binary via go:embed (web/embed.go).

.git
.worktrees

# CodeGraph index is ~24 MB and irrelevant to the binary.
.codegraph
.openidea

# CI, docs, editor noise, and files the Go compiler never reads.
.github
docs
deploy
*.md
.DS_Store
.idea
.vscode
docker-compose*.yml
Makefile
.goreleaser.yaml

# Local runtime state: never bake databases, env files or captures into an image
*.db
*.db-wal
*.db-shm
.env
.env.*
captures/
data/
bin/
coverage.*
*.test
trace*.json
