# freegate configuration — copy to .env and edit

# Server port
PORT=1234

# VPN settings (single-binary per-OS mode)
# freegate embeds VPNGate OpenVPN per OS (linux/darwin/windows) and exposes
# SOCKS5 on 127.0.0.1:9050 in-process. No Docker sidecar required.
# Set VPN_ENABLED=false or run with --vpn=false for direct (no tunnel).
VPN_ENABLED=true
VPN_PROVIDER=auto
VPNGATE_SOCKS_PORT=9050
VPNGATE_CTRL_PORT=8080
# Minimum seconds between scheduled IP rotations (ForceNewIP bypasses it)
VPNGATE_ROTATE_INTERVAL=30
# Country filter for relay selection (single-binary mode): country name
# substring or ISO code; prefix with "!" to exclude. Empty = every relay.
# Examples: VPNGATE_COUNTRY=Japan   VPNGATE_COUNTRY=JP   VPNGATE_COUNTRY=!US
# VPNGATE_COUNTRY=
# Legacy docker sidecar filters only (not applied in single-binary mode):
# VPNGATE_MIN_SCORE=500000
# VPNGATE_MAX_PING=100
# Legacy docker sidecar compat (optional): if VPNGATE_HOST is set to "vpn",
# SOCKS will dial that host instead of 127.0.0.1.
# VPNGATE_HOST=vpn

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Admin token — required, >=6 chars (user-defined password). Protects dashboard (/, /partials/*, /api/*) and is also valid for /v1/* (superset).
# Generate with: openssl rand -hex 32  (or any password >=6 chars)
ADMIN_TOKEN= # required, >=6 chars
# API keys for /v1/* (comma-separated, any entry valid; admin token also valid there).
# Empty = /v1/* stays admin-gated: only the dashboard login cookie (fg_admin) or
# raw ADMIN_TOKEN header grants access — there is no open API.
API_KEY=     # comma-separated, e.g. key1,key2

# Rate limit per IP (requests per minute)
RATE_LIMIT=60

# Trust X-Forwarded-For / X-Real-IP when deriving the client IP (rate limit
# buckets, logs, request history). Leave false when freegate is exposed
# directly — forwarded headers are client-controlled and spoofable. Set true
# ONLY behind a reverse proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false

# === Upstream: OpenCode (default) ===
UPSTREAM_URL_OPENCODE=https://opencode.ai/zen/v1
# Comma-separated API keys. freegate rotates them round-robin per request so
# per-key rate limits spread across accounts. Default "public" (anonymous).
UPSTREAM_KEY_OPENCODE=public

# Comma-separated model IDs that are free on the OpenCode upstream but do
# not follow the "-free" naming convention. These get served even without
# the suffix. Default includes "big-pickle" (served as deepseek-v4-flash
# with cost 0 by the upstream).
UPSTREAM_OPENCODE_FREE_ALLOWLIST=big-pickle
UPSTREAM_REFRESH_OPENCODE=60

# === Upstream: Kilo ===
UPSTREAM_URL_KILO=https://api.kilo.ai/api/openrouter
UPSTREAM_KEY_KILO=anonymous
UPSTREAM_REFRESH_KILO=60

# === Upstream: LLM7 (keyless gateway) ===
# api.llm7.io is a keyless free gateway: any non-empty bearer token works.
# freegate sends "unused" by convention; the upstream ignores its value.
UPSTREAM_URL_LLM7=https://api.llm7.io/v1
# How often to refresh the LLM7 /models catalog (seconds). 300s balances
# freshness vs free-relay pressure; last-known models stay cached on failure.
UPSTREAM_REFRESH_LLM7=300

# === Routing ===
# Default upstream: "opencode" or "kilo"
UPSTREAM_DEFAULT=opencode

# === Responses API direct config ===
# Comma-separated substrings (case-insensitive) matched against model ID to
# decide which models use the OpenAI Responses API (/v1/responses) instead of
# Chat Completions (/v1/chat/completions). Default covers Muse Spark family.
# Example: RESPONSE_MODELS=muse-spark,custom-model
RESPONSE_MODELS=muse-spark,muse_spark

# === Raw upstream response log (debugging) ===
# Master switch, default false. When true, every upstream response line is
# printed to stdout via slog ("upstream raw response", with request-id and
# model) so degenerate upstream behavior — e.g. muse-spark streams that end
# without [DONE] — is visible directly in the server log.
# WARNING: lines contain full conversation content; enable only while
# debugging on trusted machines.
UPSTREAM_CAPTURE=false
